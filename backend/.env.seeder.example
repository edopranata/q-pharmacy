# Database Seeder Configuration
# Copy these variables to your .env file to customize seeding amounts

# Master Data Seeding Configuration
# Adjust these values based on your needs:
# - Development: Use higher values for comprehensive testing
# - Testing: Use lower values for faster test execution
# - Production: Use minimal values for essential data only

# Number of categories to generate (default: 10)
# Categories include pharmaceutical product categories
SEED_CATEGORY_COUNT=10

# Number of suppliers to generate (default: 8)
# Suppliers include pharmaceutical companies and distributors
SEED_SUPPLIER_COUNT=8

# Number of units to generate (default: 10)
# Units include measurement units for pharmaceutical products
SEED_UNIT_COUNT=10

# Example configurations for different environments:

# Development Environment (comprehensive testing)
# SEED_CATEGORY_COUNT=20
# SEED_SUPPLIER_COUNT=15
# SEED_UNIT_COUNT=15

# Testing Environment (fast execution)
# SEED_CATEGORY_COUNT=5
# SEED_SUPPLIER_COUNT=3
# SEED_UNIT_COUNT=5

# Production Environment (minimal essential data)
# SEED_CATEGORY_COUNT=3
# SEED_SUPPLIER_COUNT=2
# SEED_UNIT_COUNT=4

# Note: Essential data will always be created regardless of these settings:
# - Essential categories: Obat Bebas, Obat Keras, Suplemen
# - Essential units: Tablet, Kapsul, Botol, Box
# - Essential suppliers: PT Kimia Farma, PT Kalbe Farma
# - Admin user: admin@apotek.com
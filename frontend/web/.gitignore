# ===================================
# Vue.js/Quasar Frontend .gitignore
# ===================================

# ===== Dependencies =====
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ===== Environment & Configuration =====
.env
.env.*
!.env.example
.env.local*
.env.development.local
.env.test.local
.env.production.local

# ===== Quasar Framework =====
# Core directories
.quasar/
/dist/
/build/
/quasar.config.*.temporary.compiled*

# Quasar build outputs
/src-ssr/
/src-pwa/service-worker.js

# ===== Mobile Development =====
# Cordova
/src-cordova/node_modules/
/src-cordova/platforms/
/src-cordova/plugins/
/src-cordova/www/

# Capacitor
/src-capacitor/www/
/src-capacitor/node_modules/

# Electron
/src-electron/dist/
/dist-electron/

# ===== IDE & Editor Files =====
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~
.project
.buildpath
.settings/
*.sublime-project
*.sublime-workspace

# ===== OS Generated Files =====
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
.thumbs.db
Thumbs.db
desktop.ini

# ===== Build & Deployment =====
dist/
build/
*.tgz
*.tar.gz
*.zip

# ===== Testing =====
/coverage/
/.nyc_output/
/test-results/
/playwright-report/
/test-results/
/playwright/.cache/

# ===== Cache & Temporary Files =====
.cache/
.parcel-cache/
.npm/
.eslintcache
.stylelintcache
*.tmp
*.temp
*.pid
*.seed
*.pid.lock

# ===== Package Managers =====
package-lock.json
yarn.lock
pnpm-lock.yaml

# ===== Logs =====
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ===== Runtime & Process =====
pids/
*.pid
*.seed
*.pid.lock

# ===== Optional npm cache directory =====
.npm

# ===== Optional eslint cache =====
.eslintcache

# ===== Microbundle cache =====
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# ===== Optional REPL history =====
.node_repl_history

# ===== Output of 'npm pack' =====
*.tgz

# ===== Yarn Integrity file =====
.yarn-integrity

# ===== dotenv environment variables file =====
.env.test

# ===== Storybook build outputs =====
.out
.storybook-out
storybook-static

# ===== Custom Application Files =====
# Add any project-specific files here
/public/uploads/*
!public/uploads/.gitkeep
/docs/generated/
*.local
